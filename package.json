{
  "name": "weknora-mcp-access-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OAuth-protected, read-only MCP gateway for Tencent WeKnora",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noaul/weknora-mcp.git"
  },
  "engines": {
    "node": ">=20.20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:baseline": "node dist/scripts/check-upstream-baseline.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
